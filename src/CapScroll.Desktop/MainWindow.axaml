<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:CapScroll.Desktop.Controls"
    mc:Ignorable="d"
    x:Class="CapScroll.Desktop.MainWindow"
    Width="700"
    Height="450"
    MinWidth="620"
    MinHeight="450"
    Icon="avares://CapScroll.Desktop/Assets/Images/logo.png"
    Title="CapScroll"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource BackgroundBrush}">

    <Window.Styles>
        <StyleInclude Source="avares://CapScroll.Desktop/Styles/Buttons.axaml" />
    </Window.Styles>

    <Grid
        RowDefinitions="Auto,Auto,*,Auto"
        Margin="24">

        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto"
            Margin="0,0,0,20">

            <StackPanel
                Grid.Column="0"
                Spacing="4">

                <TextBlock
                    Text="CapScroll"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="{DynamicResource PrimaryTextBrush}" />

                <TextBlock
                    Text="a Linux desktop tool to take long, full-page scrolling screenshots easily"
                    FontSize="14"
                    Foreground="{DynamicResource SecondaryTextBrush}" />

            </StackPanel>

            <!-- PALETTE ( a bit unnecessary yet we have it -->

            <StackPanel
                Grid.Column="1"
                Spacing="5"
                HorizontalAlignment="Right">

                <ComboBox
                    x:Name="PaletteComboBox"
                    Width="100"
                    Height="36"
                    BorderThickness="0"
                    Background="{DynamicResource BackgroundBrush}"
                    SelectedIndex="0"
                    SelectionChanged="PaletteComboBox_OnSelectionChanged">

                    <ComboBox.Resources>
                        <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="BackgroundBrush" />
                        <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="BackgroundBrush" />
                    </ComboBox.Resources>


                    <ComboBoxItem>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="5">

                            <Ellipse
                                Width="14"
                                Height="14"
                                Fill="#0B0F14" />

                            <Ellipse
                                Width="14"
                                Height="14"
                                Fill="#111820" />

                            <Ellipse
                                Width="14"
                                Height="14"
                                Fill="#4F8CFF" />

                        </StackPanel>
                    </ComboBoxItem>

                    <ComboBoxItem>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="5">

                            <Ellipse
                                Width="14"
                                Height="14"
                                Fill="#07151C" />

                            <Ellipse
                                Width="14"
                                Height="14"
                                Fill="#0D2029" />

                            <Ellipse
                                Width="14"
                                Height="14"
                                Fill="#19A7CE" />

                        </StackPanel>
                    </ComboBoxItem>

                    <ComboBoxItem>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="5">

                            <Ellipse
                                Width="14"
                                Height="14"
                                Fill="#111316" />

                            <Ellipse
                                Width="14"
                                Height="14"
                                Fill="#191C20" />

                            <Ellipse
                                Width="14"
                                Height="14"
                                Fill="#8B95A5" />

                        </StackPanel>
                    </ComboBoxItem>

                    <ComboBoxItem>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="5">

                            <Ellipse
                                Width="14"
                                Height="14"
                                Fill="#100B18" />

                            <Ellipse
                                Width="14"
                                Height="14"
                                Fill="#181021" />

                            <Ellipse
                                Width="14"
                                Height="14"
                                Fill="#A970FF" />

                        </StackPanel>
                    </ComboBoxItem>

                </ComboBox>

            </StackPanel>

        </Grid>


        <!-- preview of the selected -->
        <Border
            Grid.Row="1"
            Height="6"
            Margin="0,0,0,20"
            CornerRadius="3"
            Background="{DynamicResource AccentBrush}" />


        <!-- platform info -->
        <Border
            Grid.Row="2"
            Padding="20"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{DynamicResource BorderBrush}"
            Background="{DynamicResource SurfaceBrush}">

            <StackPanel
                Spacing="16">

                <TextBlock
                    Text="Platform"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="{DynamicResource PrimaryTextBrush}" />

                <Border
                    Height="1"
                    Background="{DynamicResource BorderSubtleBrush}" />


                <!-- z linux session -->

                <StackPanel
                    Spacing="4">

                    <TextBlock
                        Text="Session"
                        FontSize="12"
                        Foreground="{DynamicResource SecondaryTextBrush}" />

                    <TextBlock
                        x:Name="PlatformText"
                        Text="Detecting..."
                        Foreground="{DynamicResource PrimaryTextBrush}" />

                </StackPanel>


                <!-- Backend -->

                <StackPanel
                    Spacing="4">

                    <TextBlock
                        Text="Capture Backend"
                        FontSize="12"
                        Foreground="{DynamicResource SecondaryTextBrush}" />

                    <TextBlock
                        x:Name="BackendText"
                        Text="Backend: Detecting..."
                        Foreground="{DynamicResource PrimaryTextBrush}" />

                </StackPanel>


                <!-- Display -->
                <StackPanel
                    Spacing="4">

                    <TextBlock
                        Text="Display"
                        FontSize="12"
                        Foreground="{DynamicResource SecondaryTextBrush}" />

                    <TextBlock
                        x:Name="X11Text"
                        Text="X11: Detecting..."
                        Foreground="{DynamicResource PrimaryTextBrush}" />

                </StackPanel>

            </StackPanel>

        </Border>


       <!-- actions -->
        <StackPanel
            Grid.Row="3"
            Orientation="Horizontal"
            Spacing="12"
            Margin="0,20,0,0">

            <!-- Capture Region -->
            <controls:ScButton
                x:Name="CaptureButton"
                Click="CaptureButton_OnClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="M3 3h6v2H5v4H3V3zm12 0h6v6h-2V5h-4V3zM3 15h2v4h4v2H3v-6zm16 4v-4h2v6h-6v-2h4z"
                              Width="16" Height="16" />
                    <TextBlock Text="Region" VerticalAlignment="Center" FontSize="13" />
                </StackPanel>
            </controls:ScButton>

            <!-- CapScroll(Scrolling Capture) -->
            <controls:ScButton
                x:Name="CapScrollButton"
                Click="CapScrollButton_OnClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon
                        Data="M12 2a1 1 0 0 1 1 1v14.586l3.293-3.293a1 1 0 0 1 1.414 1.414l-5 5a1 1 0 0 1-1.414 0l-5-5a1 1 0 1 1 1.414-1.414L11 17.586V3a1 1 0 0 1 1-1z"
                        Width="16" Height="16" />
                    <TextBlock Text="Scrolling Capture" VerticalAlignment="Center" FontSize="13" />
                </StackPanel>
            </controls:ScButton>

            <!-- View Captures -->
            <controls:ScButton
                Click="ViewCapturesButton_OnClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon
                        Data="M4 5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H4zm16 12H4l4.5-6 3.5 4.5 2.5-3 5.5 7z"
                        Width="16" Height="16" />
                    <TextBlock Text="Gallery" VerticalAlignment="Center" FontSize="13" />
                </StackPanel>
            </controls:ScButton>

        </StackPanel>

        <!-- pverlay -->
        <Border
            x:Name="ProcessingOverlay"
            Grid.Row="0"
            Grid.RowSpan="4"
            IsVisible="False"
            Background="{DynamicResource BackgroundBrush}"
            CornerRadius="12"
            Padding="40">

            <Grid
                RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Width="420">

                <TextBlock
                    x:Name="ProcessingTitle"
                    Text="Processing capture"
                    FontSize="24"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource PrimaryTextBrush}" />

                <TextBlock
                    Grid.Row="1"
                    x:Name="ProcessingStatus"
                    Text="Preparing..."
                    FontSize="14"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource SecondaryTextBrush}" />

                <ProgressBar
                    Grid.Row="2"
                    x:Name="ProcessingProgress"
                    Minimum="0"
                    Maximum="100"
                    Value="0"
                    Height="8"
                    Margin="0,28,0,0" />

                <TextBlock
                    Grid.Row="3"
                    x:Name="ProcessingPercentage"
                    Text="0%"
                    FontSize="13"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource SecondaryTextBrush}" />

                <TextBlock
                    Grid.Row="4"
                    x:Name="ProcessingDetail"
                    Text="Waiting..."
                    FontSize="12"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource SecondaryTextBrush}" />

            </Grid>

        </Border>

    </Grid>
</Window>
